# Copy this file to .env and fill in real values. Never commit .env.

# Required for Phase 1 (image classification)
ANTHROPIC_API_KEY=

# Required starting Phase 2 (eBay Browse API — free developer signup)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Required for Phase 3 (SerpApi — Google Shopping, free tier 250 searches/month)
SERPAPI_KEY=

# Optional — fallback identification via Google Cloud Vision (web/label detection).
# Only called when Claude's classification comes back "unrecognized", to try to
# rescue the scan before giving up. Get a key at https://console.cloud.google.com/
# (enable the "Cloud Vision API" on a project, then create an API key). Free tier is
# 1,000 units/month; leave unset to skip this fallback entirely.
GOOGLE_VISION_API_KEY=

# Recommended once deployed publicly (e.g. Render) — every endpoint except /health
# requires this exact value in an X-App-Secret header, or requests are rejected.
# Leave unset for local dev (auth is skipped entirely when this is empty). Pick any
# long random string; it must match EXPO_APP_SHARED_SECRET in app/.env.
APP_SHARED_SECRET=

# Optional
PORT=3000
