# Copy this file to .env and fill in real values. Never commit .env.

# Required for Phase 1 (image classification)
ANTHROPIC_API_KEY=

# Required for price/listing data (SerpApi — Google Shopping, free tier 250
# searches/month). This is the sole price/listing source in the app; without it,
# /price-search returns no pricing data and Outfit Matches shows keyword ideas with
# no purchasable items.
SERPAPI_KEY=

# Optional — Google Cloud Vision, run in parallel with every classification call
# (not just as a fallback) for brand augmentation (logo detection) and as a backstop
# if Claude can't identify the item at all. Get a key at
# https://console.cloud.google.com/ (enable the "Cloud Vision API" on a project,
# then create an API key). Free tier is 1,000 units/month/feature; leave unset to
# skip Vision entirely — classification still works with Claude (+ Gemini) alone.
GOOGLE_VISION_API_KEY=

# Optional — Gemini, run in parallel with every classification call as a second,
# independent full opinion (brand cross-validation, plus a stronger rescue than
# Vision's hint if Claude can't identify the item at all). Get a key at
# https://aistudio.google.com/ (API keys section). Unlike every other key here,
# Gemini 3.1 Pro has NO free tier — it's billed from the first call (~$2/M input,
# ~$12/M output tokens as of writing; at this project's scale that's rough pennies
# overall, but worth knowing going in). Leave unset to skip Gemini entirely.
GEMINI_API_KEY=

# Optional — persists corrections.jsonl and classifications.jsonl (see
# server/src/lib/correctionLog.ts / classificationLog.ts) to a Hugging Face
# Storage Bucket via its S3-compatible gateway, so both logs survive Render's
# free-tier restarts/redeploys (which otherwise wipe server/data/ every time —
# there's no persistent disk there by default). One-time manual setup outside
# this app: create a bucket at https://huggingface.co/new-bucket (or `hf buckets
# create <name>` via the hf CLI), then generate S3 credentials from a User Access
# Token's dropdown ("Generate S3 credentials", Write scope) at
# https://huggingface.co/settings/tokens. HF_BUCKET_S3_ENDPOINT is the full
# gateway URL scoped to your namespace, e.g. https://s3.hf.co/your-username.
# Leave any of these 4 unset to skip bucket sync entirely — both logs still work
# exactly as local-only files, same as before this existed.
HF_BUCKET_S3_ENDPOINT=
HF_BUCKET_NAME=
HF_BUCKET_ACCESS_KEY_ID=
HF_BUCKET_SECRET_ACCESS_KEY=

# Recommended once deployed publicly (e.g. Render) — every endpoint except /health
# requires this exact value in an X-App-Secret header, or requests are rejected.
# Leave unset for local dev (auth is skipped entirely when this is empty). Pick any
# long random string; it must match EXPO_APP_SHARED_SECRET in app/.env.
APP_SHARED_SECRET=

# Optional
PORT=3000
