# Copy to .env. Point this at your backend — use your PC's LAN IP for a physical
# device on Expo Go (localhost only works in an iOS simulator), or your deployed
# Render URL if you're not hosting the backend locally.
#
# No EXPO_PUBLIC_ prefix on these two, on purpose — app.config.js reads them at
# build/config time and re-exposes them via `extra` (see that file), and app code
# reads them through expo-constants instead of process.env. They still end up in
# the shipped bundle either way (that's unavoidable for anything the client needs
# to call the backend with) — this only changes the env var names and how the app
# code accesses them, not what's exposed.
EXPO_API_URL=http://192.168.1.100:3000

# Must match APP_SHARED_SECRET on the backend, if the backend has one set. Leave
# blank if the backend doesn't require it (e.g. local dev with no secret set).
EXPO_APP_SHARED_SECRET=
