# Copy to .env. Point this at your backend — use your PC's LAN IP for a physical
# device on Expo Go (localhost only works in an iOS simulator), or your deployed
# Render URL if you're not hosting the backend locally.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Must match APP_SHARED_SECRET on the backend, if the backend has one set. Leave
# blank if the backend doesn't require it (e.g. local dev with no secret set).
EXPO_PUBLIC_APP_SHARED_SECRET=
