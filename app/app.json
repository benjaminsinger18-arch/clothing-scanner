{
  "expo": {
    "name": "Clothing Scanner",
    "slug": "clothing-scanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clothingscanner.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph a piece of clothing to identify it.",
        "NSPhotoLibraryUsageDescription": "Used to pick an existing photo of a piece of clothing."
      }
    },
    "android": {
      "package": "com.clothingscanner.app",
      "versionCode": 1,
      "permissions": ["CAMERA"]
    }
  }
}
